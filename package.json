{
  "name": "accounting-software-new-tauri",
  "version": "1.0.0",
  "description": "Desktop accounting application built with Tauri 2.x + React + TypeScript",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "verify:modules": "node scripts/verify-module-frameworks.mjs",
    "verify:exports": "node scripts/verify-export-templates.mjs",
    "verify:live-data": "node scripts/verify-live-module-data.mjs",
    "verify:routes": "node scripts/audit-routes-visual.mjs",
    "verify:accessibility": "node scripts/audit-routes-accessibility.mjs",
    "verify:route-content": "node scripts/audit-route-content.mjs",
    "verify:source-reachability": "node scripts/verify-source-reachability.mjs",
    "verify:pdf-sanitization": "node scripts/verify-pdf-sanitization.mjs",
    "verify:desktop": "node scripts/verify-desktop-targets.mjs",
    "verify:release-acceptance": "cargo test --manifest-path src-tauri/Cargo.toml release_acceptance -- --nocapture",
    "verify:release-recovery": "cargo test --manifest-path src-tauri/Cargo.toml release_recovery -- --nocapture",
    "verify:macos-bundle": "node scripts/verify-macos-bundle.mjs",
    "verify:windows-bundle": "node scripts/verify-windows-bundle.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@province-city-china/level": "^9.0.0",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.7.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0",
    "read-excel-file": "^9.2.0",
    "tailwind-merge": "^3.5.0",
    "write-excel-file": "^4.1.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.59.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.4.5"
  }
}
